site/

# --- Editors / OS -----------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store

# --- markproof runtime output ------------------------------------------------
# Reports and evidence are build artefacts, produced per run, never committed.
report.json
report.pdf
artifacts/
.markproof/

# --- Secrets ----------------------------------------------------------------
# Signing keys, endpoint tokens and watermark configs come from the environment
# or CI secrets. If one of these ever appears here, something went wrong.
.env
.env.*
secrets/
*.pem
*.key
watermark_config.json
# ...except the demo bot's, which is test material, not a secret: throwaway keys
# for a bot that serves fixed strings. Without it the demo and the dogfood
# workflow cannot run, and a rule that silently breaks the example it ships with
# protects nothing.
!examples/demo-bot/watermark_config.json
