*$py.class
*.so
build/
dist/
sdist/
wheels/
*.egg-info/
.eggs/
.installed.cfg
MANIFEST

# --- Environments -----------------------------------------------------------
.venv/
venv/
env/
.python-version

# --- Tooling caches ---------------------------------------------------------
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
